# Choose: openai/gpt, deepseek, anthropic/claude
MODEL_PROVIDER=openai
MODEL=gpt-4o-mini
API_KEY=replace-me

# Optional provider-specific keys. API_KEY takes precedence when both are set.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom OpenAI-compatible or Anthropic endpoint.
# DeepSeek defaults to https://api.deepseek.com when this is empty.
BASE_URL=
MODEL_TEMPERATURE=0.1
MAX_TOKENS=
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2

# MCP Server tool credentials.
TAVILY_API_KEY=replace-me
FIRECRAWL_API_KEY=replace-me

# Network MCP Server bind configuration.
MCP_HTTP_HOST=127.0.0.1
MCP_SSE_PORT=3001
MCP_STREAMABLE_HTTP_PORT=3002

# Tool and Agent limits.
MCP_TOOL_TIMEOUT_MS=60000
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_CHARACTERS=20000

# LangSmith tracing and Studio. Traces are written to project "mcp_demo".
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=mcp_demo

# SYSTEM_PROMPT=You are a web research assistant. Use MCP tools when current or source-backed information is needed.
