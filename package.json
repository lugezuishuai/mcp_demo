{
  "name": "langgraph-mcp-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/host-entry.ts",
    "doctor": "tsx src/doctor.ts",
    "env:init": "tsx scripts/init-env.ts",
    "format": "prettier \"{src,tests,scripts}/**/*.ts\" \"*.{json,mjs}\" --write",
    "format:check": "prettier \"{src,tests,scripts}/**/*.ts\" \"*.{json,mjs}\" --check",
    "host:sse": "tsx src/host-entry.ts --transport sse",
    "host:stdio": "tsx src/host-entry.ts --transport stdio",
    "host:streamable-http": "tsx src/host-entry.ts --transport streamable-http",
    "mcp:inspect:sse": "npx -y @modelcontextprotocol/inspector --web --transport sse --server-url http://127.0.0.1:3001/sse",
    "mcp:inspect:stdio": "npx -y @modelcontextprotocol/inspector node --import tsx src/mcp-server-stdio-entry.ts",
    "mcp:inspect:streamable-http": "npx -y @modelcontextprotocol/inspector --web --transport http --server-url http://127.0.0.1:3002/mcp",
    "mcp:server": "npm run mcp:stdio",
    "mcp:sse": "node --enable-source-maps --import tsx src/mcp-server-sse-entry.ts",
    "mcp:stdio": "node --enable-source-maps --import tsx src/mcp-server-stdio-entry.ts",
    "mcp:streamable-http": "node --enable-source-maps --import tsx src/mcp-server-streamable-http-entry.ts",
    "studio": "npx -y @langchain/langgraph-cli dev --no-browser",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.4",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tavily/core": "^0.7.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firecrawl": "^4.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
